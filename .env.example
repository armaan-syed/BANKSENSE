# BankSense runtime configuration.
# Copy this file to `.env` and fill in the Supabase project values.
# Never commit the real `.env` file.
#
# Production split:
#   - Backend values (SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY,
#     BANKSENSE_CORS_ORIGINS) are Fly.io secrets. Set them with
#     `fly secrets set`; do not put them in backend/fly.toml.
#   - Frontend values (VITE_*) are Vercel environment variables and are baked
#     into the static bundle at build time.
# See DEPLOY_VERCEL.md for the full flow.

# Leave blank to auto-select Supabase when credentials are present, or set
# `sqlite` / `supabase` explicitly.
BANKSENSE_DB_BACKEND=

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...|legacy anon key>
# Optional secret key, used for administrative server-side tasks.
SUPABASE_SECRET_KEY=
# Optional: only for legacy HS256 projects; new projects use JWKS/ES256.
SUPABASE_JWT_SECRET=

# Migration-only Postgres connection (Supabase Connect -> Session pooler).
DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Optional browser overrides. If blank, Vite falls back to SUPABASE_URL and
# SUPABASE_PUBLISHABLE_KEY above.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local development: leave blank to use the Vite `/api` proxy.
# Vercel production: set this to the Fly.io HTTPS origin, for example
# https://banksense-api.fly.dev (no trailing slash).
VITE_API_BASE_URL=

# Optional: set to 0 to disable the optional ~1.2 GB abstractive summariser.
# Local default is 1. backend/fly.toml sets 0 for the 2 GB Fly.io machine.
BANKSENSE_ENABLE_SUMMARY=1

# Optional: override the model directory (defaults to backend/models).
BANKSENSE_MODELS_DIR=

# Local development origins. In production set the exact Vercel origin, e.g.
# BANKSENSE_CORS_ORIGINS=https://<your-project>.vercel.app
BANKSENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
