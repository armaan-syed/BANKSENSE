# Vercel hosts the React frontend only. The FastAPI backend, its Python
# dependencies, and the trained model artifacts are deployed separately to
# Fly.io (see backend/fly.toml and DEPLOY_VERCEL.md).

# Backend, model artifacts, and local data never belong in the Vercel upload.
backend/
BANKSENSE-armaan/
data/
scripts/

# Model archives and binary artifacts, including root-level files. Vercel only
# needs the frontend source; never upload trained models or private archives.
model.zip
/models/
*.zip
*.joblib
*.npy
*.pkl
*.pickle
*.onnx
*.pt
*.pth
*.safetensors
*.h5
*.keras
*.bin
*.tar
*.tar.gz
*.tgz

# Secrets and local environment files. Never upload these to Vercel.
.env
.env.*
!.env.example
!frontend/.env.example

# Local build output and dependencies.
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Python caches and virtual environments.
**/__pycache__/
**/*.py[cod]
.venv/
venv/
.pytest_cache/

# OS / editor files.
.DS_Store
.idea/
.vscode/
